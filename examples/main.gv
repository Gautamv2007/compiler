check_prime = (a:int) -> {
  i:int = 2;
  flag:int = 0;
  while(i < a){
    rem:int = a % i;
    if (rem == 0){
      flag = 1;
    }
    i = i + 1;
  }

  return flag;
}


main = () -> {
  n:int = 9;
  if (check_prime(n)){
      print_str("Not prime\n");
  }
  else{
      print_str("Prime\n");
  }

  return 0;
}
