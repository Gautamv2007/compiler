check = (x:int) -> {
  i:int = 2;
  flag:int = 0;
  while(i < x){
    rem:int = x%i;

    print("Testing i: ", i, " Rem: ", rem, "\n");

    if (rem == 0){
      flag = 1;
    }
    i = i + 1;
  }
  return flag;
}

main = () -> {
  print("Enter a number: ");
  x:int = to_int(input());

  out:int = check(x);

  if (out == 0){
    print("The number is prime\n");
  }
  else {
    print("The number is not prime\n");
  }

  return 0;
}